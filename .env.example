# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local runs (outside docker compose). Compose overrides these with the `db` host.
DATABASE_URL=postgresql+psycopg://rag_app:rag_app@localhost:5432/rag
ADMIN_DATABASE_URL=postgresql+psycopg://rag_admin:rag_admin@localhost:5432/rag
POSTGRES_PASSWORD=rag_admin
RAG_APP_PASSWORD=rag_app

# --- Authentication --------------------------------------------------------
# dev: HS256 demo tokens from `make tokens` (refused when ENVIRONMENT=production)
AUTH_MODE=dev
DEV_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# entra: Microsoft Entra ID access tokens
# AUTH_MODE=entra
# ENTRA_TENANT_ID=<tenant-guid>
# ENTRA_AUDIENCE=<api-app-registration-client-id>
# Optional, for users in too many groups (groups overage):
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
ADMIN_ROLE=Documents.Admin

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<chat-deployment-name>
# Leave empty to authenticate with Entra ID (managed identity / az login).
AZURE_OPENAI_API_KEY=

# Or any OpenAI-compatible endpoint, e.g. Ollama:
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b
# OPENAI_API_KEY=

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
MAX_VECTOR_DISTANCE=0.75
RERANKER_ENABLED=false
